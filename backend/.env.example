# Local development only. Never commit real secrets.
DATABASE_URL=sqlite:///./transitops.db

# Production: use a managed PostgreSQL connection string (Neon, Supabase, etc.).
# DATABASE_URL=postgresql://user:password@host:5432/transpilot

# Optional secret reserved for future signing/integration features.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional demo data for local/dev only. Keep false in production.
SEED_DEMO_DATA=false

# Direct API access allow-list. Same-origin Vercel Services deployments do not need this.
CORS_ORIGINS=http://localhost:5173

# One-time first-admin bootstrap. Set a long random value in production,
# call POST /api/auth/bootstrap/admin with X-Bootstrap-Key, then rotate/remove it.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-bootstrap-key
