# Local development only. Never commit real secrets.
DATABASE_URL=sqlite:///./transitops.db

# Production: use a managed PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/transpilot

# Long random application secret.
AUTH_SECRET=replace-with-a-long-random-secret

# Only needed when the browser calls the API from a different origin.
CORS_ORIGINS=http://localhost:5173

# One-time first-admin bootstrap key. Rotate/remove it after initialization.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-bootstrap-key
