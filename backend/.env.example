# Local development only. Never commit real secrets.
DATABASE_URL=sqlite:///./transitops.db

# Production: use a managed PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/transpilot

# Use a long random secret in production.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional demo data for local/dev only.
SEED_DEMO_DATA=true

# Optional CORS allow-list for direct API access.
CORS_ORIGINS=http://localhost:5173
